{
  "manifest_version": 3,
  "name": "FocusForge",
  "version": "1.0",
  "description": "Mindful bouncer for distracting websites",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*"
      ],
      "css": ["overlay.css"],
      "js": ["content.js", "overlay.js"],
      "run_at": "document_start"
    }
  ]
}
