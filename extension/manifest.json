{
  "manifest_version": 3,
  "name": "FocusForge",
  "version": "1.0",
  "description": "Mindful bouncer for distracting websites",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "css": [
        "overlay.css"
      ],
      "js": [
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
